# WolfCart storefront config — lablezza.wolfcart.shop
# Copy this file to .env(.local) for local development.

# ── Server-side (used by server.ts in dev, and injected as CF Pages env vars) ─
WOLFCART_TENANT_SLUG=lablezza
WOLFCART_API_KEY=wc_live_replace_with_real_storefront_api_key
WOLFCART_API_URL=https://api.wolfcart.shop

# ── Client-side (used only when the built bundle talks to the API directly —
#    i.e. static R2 deploys without the Cloudflare Pages Functions proxy) ─────
VITE_WOLFCART_TENANT_SLUG=lablezza
VITE_WOLFCART_API_KEY=wc_live_replace_with_real_storefront_api_key
VITE_WOLFCART_API_URL=https://api.wolfcart.shop
